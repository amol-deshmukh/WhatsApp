<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 11 and lower. Same policy as data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="media" />
    <exclude domain="file" path="fake_cdn" />
    <exclude domain="sharedpref" path="db_key.xml" />
</full-backup-content>
