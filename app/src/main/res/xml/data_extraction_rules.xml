<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup/transfer rules.
    Chats, media and key material never leave the device through Android backup:
     - they're private communications (the user may not expect them in their cloud account),
     - the DB is encrypted with a Keystore-bound key that is NOT backed up, so a restored DB
       would be unreadable anyway.
    Product answer for "I switched phones": an app-level, end-to-end encrypted backup with a
    user-held key (WhatsApp model), or re-sync from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="media" />
        <exclude domain="file" path="fake_cdn" />
        <exclude domain="sharedpref" path="db_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="media" />
        <exclude domain="file" path="fake_cdn" />
        <exclude domain="sharedpref" path="db_key.xml" />
    </device-transfer>
</data-extraction-rules>
